# --- Auth ---
# Secret used to sign JWT session tokens. Set this to a long random string in production.
JWT_SECRET=change-this-to-a-long-random-string

# --- Database (Postgres) ---
# Any Postgres works: Vercel Postgres, Neon, Supabase, Railway, etc.
# In Vercel: Project -> Storage -> Create Database -> Postgres, this gets set for you.
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- File uploads (pCloud) ---
# 1. Register an OAuth app at https://docs.pcloud.com/my_apps/ to get these two:
PCLOUD_CLIENT_ID=
PCLOUD_CLIENT_SECRET=
# 2. Set PCLOUD_REDIRECT_URI to your deployed app + /api/pcloud/callback, e.g.:
#    https://your-app.vercel.app/api/pcloud/callback
#    (must exactly match the redirect URI configured on the pCloud app)
PCLOUD_REDIRECT_URI=
# 3. Deploy with just the three above set, then visit /api/pcloud/authorize
#    in your browser (signed into the pCloud account you want to use) to
#    approve access. You'll land on a page showing the two values below —
#    copy them in, then redeploy:
PCLOUD_ACCESS_TOKEN=
PCLOUD_API_HOST=api.pcloud.com
# Optional: a specific pCloud folder id to upload into (0 = root).
PCLOUD_FOLDER_ID=0

# --- Real-time sync (Pusher Channels — free tier) ---
# Create an app at https://dashboard.pusher.com -> Channels -> Create app.
# Copy the values from "App Keys".
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# Same key/cluster, but exposed to the browser (must start with NEXT_PUBLIC_).
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
