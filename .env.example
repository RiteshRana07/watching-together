# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string

# --- Site-wide super-host ---
# The account with this email gets full host powers (playback control,
# queue management, co-host granting, room size, even deleting) in EVERY
# room on the site — theirs or anyone else's — without ever displacing the
# room's actual creator, who keeps their own "Host" badge and ownership.
# Leave blank to disable this entirely.
SUPER_HOST_EMAIL=ranaritesh7674@gmail.com

# --- Database (Postgres) ---
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- pCloud storage ---
# Use the API host for your pCloud data center: api.pcloud.com (US) or eapi.pcloud.com (Europe).
PCLOUD_API_HOST=https://api.pcloud.com
PCLOUD_ACCESS_TOKEN=
PCLOUD_FOLDER=/WatchTogether
PCLOUD_FOLDER_ID=
# Create a File Request for the WatchTogether folder in my.pCloud, then paste the code from its link here.
PCLOUD_UPLOAD_LINK_CODE=

# --- Real-time sync (Pusher Channels) ---
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
